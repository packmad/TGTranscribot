TELEGRAM_BOT_TOKEN=123456:abc-your-telegram-bot-token
OPENAI_API_KEY=sk-your-openai-key
ALLOWED_USERNAMES=alice,bob
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
